{
  "name": "habit-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "HABITS_AUTH=off vite dev",
    "build": "vite build && node scripts/build-sw.ts",
    "start": "srvx serve --prod --host=localhost --entry dist/server/server.js --static ../client",
    "typecheck": "tsc --noEmit",
    "lint": "eslint -c lime.eslint.config.mjs .",
